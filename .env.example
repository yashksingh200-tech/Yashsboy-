# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# SARVAM_API_KEY: (Optional) Sarvam AI API Key for natural Hindi/Hinglish Bulbul neural TTS (https://sarvam.ai)
SARVAM_API_KEY=

# GROQ_API_KEY: (Optional) Groq API Key for fast open-source Llama3/Mixtral models as secondary fallback (https://groq.com)
GROQ_API_KEY=

# OPENAI_API_KEY: (Optional) OpenAI API Key for GPT-4o-mini / GPT models (https://platform.openai.com)
OPENAI_API_KEY=

# OPENROUTER_API_KEY: (Optional) OpenRouter API Key for free open-source models (https://openrouter.ai)
OPENROUTER_API_KEY=

# OLLAMA_API_URL: (Optional) Base URL of self-hosted Ollama instance (running llama3) for final fallback (e.g. http://localhost:11434 or https://my-ollama.example.com)
OLLAMA_API_URL=

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
